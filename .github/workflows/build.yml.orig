name: Build Android APK

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build-apk:
    name: Compile Debug & Release APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'

      - name: Accept Android SDK licenses & Install SDK 36
        run: |
          yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null || true
          $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager "platforms;android-36" "build-tools;36.0.0" > /dev/null || true

      - name: Set up Gradle 9.3.1
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '9.3.1'

      - name: Prepare .env and local.properties for Secrets Plugin
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: |
          if [ ! -f .env ]; then
            if [ -f .env.example ]; then
              cp .env.example .env
            else
              touch .env
            fi
          fi
          if [ -n "$GEMINI_API_KEY" ]; then
            echo "" >> .env
            echo "GEMINI_API_KEY=$GEMINI_API_KEY" >> .env
          else
            echo "GEMINI_API_KEY=dummy_key" >> .env
          fi
          echo "sdk.dir=$ANDROID_HOME" > local.properties
          echo "GEMINI_API_KEY=${GEMINI_API_KEY:-dummy_key}" >> local.properties
          cp .env secrets.properties || true

      - name: Prepare google-services.json if missing
        run: |
          if [ ! -f app/google-services.json ]; then
            cat << 'EOF' > app/google-services.json
          {
            "project_info": {
              "project_number": "123456789012",
              "project_id": "nexus-tunnel-mock",
              "storage_bucket": "nexus-tunnel-mock.appspot.com"
            },
            "client": [
              {
                "client_info": {
                  "mobilesdk_app_id": "1:123456789012:android:1234567890abcdef",
                  "android_client_info": {
                    "package_name": "com.aistudio.nexustunnel.vprqza"
                  }
                },
                "oauth_client": [],
                "api_key": [
                  {
                    "current_key": "AIzaSyDummyKeyForCIBuildOnly123456789"
                  }
                ],
                "services": {
                  "appinvite_service": {
                    "other_platform_oauth_client": []
                  }
                }
              }
            ],
            "configuration_version": "1"
          }
          EOF
          fi

      - name: Fix compileSdk minorApiLevel for CI compatibility
        run: |
          sed -i 's/compileSdk { version = release(36) { minorApiLevel = 1 } }/compileSdk = 36/g' app/build.gradle.kts
          mkdir -p app/libs && mkdir -p dummy_aar/classes
          mkdir -p dummy_aar/src/go
          mkdir -p dummy_aar/src/libv2ray
          cat << "EOF_JAVA" > dummy_aar/src/go/Seq.java
          package go;
          public class Seq {
            public interface Proxy {}
            public static void setContext(android.content.Context c) {}
            public static void touch() {}
            public static void incByteArray(byte[] a) {}
            public static void incGoRef(String a, go.Seq.Proxy b) {}
          }
          EOF_JAVA
          cat << "EOF_JAVA2" > dummy_aar/src/libv2ray/CoreCallbackHandler.java
          package libv2ray;
          public interface CoreCallbackHandler {
            void startup();
            void shutdown();
            void onEmitStatus(long a, String b);
          }
          EOF_JAVA2
          cat << "EOF_JAVA3" > dummy_aar/src/libv2ray/Libv2ray.java
          package libv2ray;
          public class Libv2ray {
            public static void registerCoreCallbackHandler(CoreCallbackHandler h) {}
            public static void setPluginClassLoader(ClassLoader c) {}
            public static void initCoreEnv(String s, String t) {}
            public static String checkVersionX() { return ""; }
            public static CoreController newCoreController(CoreCallbackHandler h) { return new CoreController(); }
          }
          EOF_JAVA3
          cat << "EOF_JAVA4" > dummy_aar/src/libv2ray/CoreController.java
          package libv2ray;
          public class CoreController {
            public void startCore(String a) {}
            public void stopCore() {}
            public void stopLoop() {}
            public String queryAllOutboundTrafficStats() { return ""; }
          }
          EOF_JAVA4
          javac -cp "$ANDROID_HOME/platforms/android-36/android.jar" dummy_aar/src/go/Seq.java dummy_aar/src/libv2ray/CoreCallbackHandler.java dummy_aar/src/libv2ray/Libv2ray.java dummy_aar/src/libv2ray/CoreController.java -d dummy_aar/classes
          touch dummy_aar/AndroidManifest.xml
          echo '<manifest package="com.example.dummy"></manifest>' > dummy_aar/AndroidManifest.xml
          jar cvf dummy_aar/classes.jar -C dummy_aar/classes .
          cd dummy_aar
          zip -r ../app/libs/libv2ray.aar AndroidManifest.xml classes.jar
          cd .. && rm -rf dummy_aar dummy.txt

      - name: Setup Signing Environment Variables
        run: |
          STORE_PASS="${{ secrets.STORE_PASSWORD }}"
          if [ -z "$STORE_PASS" ]; then
            STORE_PASS="android"
          fi
          KEY_PASS="${{ secrets.KEY_PASSWORD }}"
          if [ -z "$KEY_PASS" ]; then
            KEY_PASS="android"
          fi
          echo "STORE_PASSWORD=$STORE_PASS" >> "$GITHUB_ENV"
          echo "KEY_PASSWORD=$KEY_PASS" >> "$GITHUB_ENV"
          echo "KEYSTORE_PATH=$GITHUB_WORKSPACE/my-upload-key.jks" >> "$GITHUB_ENV"

      - name: Prepare debug.keystore & my-upload-key.jks
        run: |
          if [ ! -f debug.keystore ]; then
            if [ -f debug.keystore.base64 ]; then
              base64 -d debug.keystore.base64 > debug.keystore
            else
              keytool -genkeypair -v \
                -keystore debug.keystore \
                -storepass android \
                -alias androiddebugkey \
                -keypass android \
                -keyalg RSA -keysize 2048 -validity 10000 \
                -dname "CN=Android Debug,O=Android,C=US"
            fi
          fi

          if [ ! -f my-upload-key.jks ]; then
            keytool -genkeypair -v \
              -keystore my-upload-key.jks \
              -storepass "$STORE_PASSWORD" \
              -alias upload \
              -keypass "$KEY_PASSWORD" \
              -keyalg RSA -keysize 2048 -validity 10000 \
              -dname "CN=NexusTunnel,O=AIStudio,C=US"
          fi

      - name: Build Debug APK
        run: |
          if [ -f ./gradlew ]; then
            chmod +x ./gradlew
            ./gradlew :app:assembleDebug --no-daemon --stacktrace
          else
            gradle :app:assembleDebug --no-daemon --stacktrace
          fi

      - name: Build Release APK
        run: |
          if [ -f ./gradlew ]; then
            ./gradlew :app:assembleRelease --no-daemon --stacktrace
          else
            gradle :app:assembleRelease --no-daemon --stacktrace
          fi

      - name: Upload Debug APK
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: app-debug-apk
          path: app/build/outputs/apk/debug/*.apk

      - name: Upload Release APK
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: app-release-apk
          path: app/build/outputs/apk/release/*.apk
